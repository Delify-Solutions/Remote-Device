# ===== Topup Gateway =====
# Địa chỉ công khai của gateway (dùng để tạo link ảnh gửi cho shop)
APP_URL=https://gateway.example.com
# Khoá bí mật dùng mã hoá thông tin đăng nhập/OTP — ĐẶT CHUỖI NGẪU NHIÊN DÀI, KHÔNG ĐỔI sau khi chạy
APP_KEY=
APP_DEBUG=false
APP_TZ=Asia/Ho_Chi_Minh

# MySQL/MariaDB (khuyên dùng khi chạy thật)
DB_DSN=mysql:host=127.0.0.1;dbname=topup_gateway;charset=utf8mb4
DB_USER=
DB_PASS=
# Hoặc SQLite cho máy dev:  DB_DSN=sqlite:/duong/dan/tuyet/doi/storage/gateway.sqlite

# Thư mục lưu ảnh (mặc định ./storage/files)
#STORAGE_DIR=
# Khoá cho /cron/tick?key=...  (để trống = tắt cron qua HTTP, dùng php bin/cron.php)
CRON_KEY=
# true nếu chạy sau proxy/CDN (lấy IP thật từ X-Forwarded-For)
TRUST_PROXY=false
# false = phải đăng nhập admin mới xem được /docs
DOCS_PUBLIC=true
